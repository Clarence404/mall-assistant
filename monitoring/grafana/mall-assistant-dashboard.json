{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "mall-assistant 智能客服",
  "uid": "mall-assistant",
  "description": "第 9 章：mall-assistant 的业务指标（/actuator/prometheus）。导入：Grafana → Dashboards → Import，选 Prometheus 数据源。",
  "tags": [
    "mall-assistant",
    "spring-ai"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "应用",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(assistant_chat_requests_total, application)",
          "refId": "A"
        },
        "definition": "label_values(assistant_chat_requests_total, application)",
        "refresh": 1,
        "current": {
          "text": "mall-assistant",
          "value": "mall-assistant"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "每秒请求数（按结果）",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (outcome) (rate(assistant_chat_requests_total{application=\"$application\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "description": "OK 之外的都是错误码：MODEL_*（模型）、RATE_LIMITED / TOO_BUSY / TOKEN_BUDGET_EXCEEDED（进门被挡）、CONVERSATION_BUSY 等"
    },
    {
      "id": 2,
      "type": "stat",
      "title": "模型错误率（5 分钟）",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(assistant_chat_requests_total{application=\"$application\",outcome=~\"MODEL_.*\"}[5m])) / clamp_min(sum(rate(assistant_chat_requests_total{application=\"$application\"}[5m])), 1e-9)",
          "legendFormat": "错误率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "模型熔断器",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(assistant_model_circuit_state{application=\"$application\"})",
          "legendFormat": "状态"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "正常",
                  "color": "green"
                },
                "1": {
                  "text": "熔断",
                  "color": "red"
                },
                "2": {
                  "text": "半开",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {},
      "description": "0 正常、1 熔断（直接返回 MODEL_CIRCUIT_OPEN）、2 半开（放一个请求去试）"
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "一轮对话耗时 p50 / p95 / p99（阻塞接口）",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(assistant_chat_duration_seconds_bucket{application=\"$application\",endpoint=\"chat\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(assistant_chat_duration_seconds_bucket{application=\"$application\",endpoint=\"chat\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(assistant_chat_duration_seconds_bucket{application=\"$application\",endpoint=\"chat\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "各意图的 p95 耗时",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, intent) (rate(assistant_chat_duration_seconds_bucket{application=\"$application\"}[$__rate_interval])))",
          "legendFormat": "{{intent}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "Agent 和 RAG 通常最慢（一轮里要调好几次模型）"
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "每分钟 Token（按步骤）",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (stage, type) (rate(assistant_model_tokens_total{application=\"$application\"}[$__rate_interval])) * 60",
          "legendFormat": "{{stage}} {{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": "estimated=true 的是按字数估算的（模型没报告用量）"
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Token 近 24 小时累计",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (estimated) (increase(assistant_model_tokens_total{application=\"$application\"}[24h]))",
          "legendFormat": "估算={{estimated}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "正在处理的对话",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 18,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(assistant_chat_inflight{application=\"$application\"})",
          "legendFormat": "在处理"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "接近 assistant.guard.max-concurrent 时，新来的请求要等，等不到返回 TOO_BUSY"
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "被挡下的请求（每分钟，按原因）",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (reason) (rate(assistant_guard_rejections_total{application=\"$application\"}[$__rate_interval])) * 60",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": "RATE_LIMITED 限流、TOO_BUSY 并发满、TOKEN_BUDGET_EXCEEDED 超每日预算"
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "RAG 检索结果（每分钟）",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (result) (rate(assistant_rag_retrievals_total{application=\"$application\"}[$__rate_interval])) * 60",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": "HIT 有资料、NO_MATCH 没找到（知识库缺这块）、ALL_BLOCKED 全被注入过滤挡下、MODEL_UNAVAILABLE 模型不可用降级给原文"
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "提示注入拦截",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (where, rule) (increase(assistant_injection_blocked_total{application=\"$application\"}[$__rate_interval]))",
          "legendFormat": "{{where}} {{rule}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": "突然变多：知识库或外部 MCP 服务被人改了，或者规则误杀了正常文档，都要人去看"
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Agent 平均步数（按停止原因）",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (stop) (rate(assistant_agent_steps_sum{application=\"$application\"}[$__rate_interval])) / clamp_min(sum by (stop) (rate(assistant_agent_steps_count{application=\"$application\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "{{stop}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": "STEP_LIMIT / REPEATED / TIMEOUT 变多说明模型在兜圈子"
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "模型调用次数（Spring AI 自带指标）",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (gen_ai_request_model) (rate(gen_ai_client_operation_seconds_count{application=\"$application\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "description": "Spring AI 的 ChatModel 观测（Ollama / OpenAI）；命令行模型没有"
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "JVM 堆内存",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (area) (jvm_memory_used_bytes{application=\"$application\"})",
          "legendFormat": "{{area}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
